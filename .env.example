# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_GROUP_ID=
TELEGRAM_MADALENA_ID=
TELEGRAM_MAFALDA_ID=
TELEGRAM_BEATRIZ_ID=

# Claude
ANTHROPIC_API_KEY=
MULTI_INTENT_MODEL=claude-haiku-4-5-20251001
# Optional override for src/lib/lead-classifier.ts (leads-email-scan cron).
LEAD_CLASSIFIER_MODEL=claude-haiku-4-5-20251001

# Notion
NOTION_API_KEY=
NOTION_BACKLOG_DB_ID=
NOTION_FOUNDER_FOCUS_DB_ID=
NOTION_PARTNER_DB_ID=
NOTION_INFLUENCER_DB_ID=
NOTION_REMINDERS_DB_ID=
NOTION_TO_DISCUSS_DB_ID=
NOTION_DECISIONS_DB_ID=
# Comms/Marketing content calendar. Only used by the pipeline-alerts cron to
# warn when something is due in <2 days but still Planned/Drafted (not
# Scheduled) — not exposed to chat.
NOTION_CONTENT_CALENDAR_DB_ID=
NOTION_LISTS_DB_ID=
NOTION_PROJECTS_DB_ID=
NOTION_EVENT_DB_ID=
# "Leads a contactar" — fed by leads-email-scan.ts (reuses OUTLOOK_MAILBOXES
# below, no new Microsoft scopes) and leads-intro-pack.ts (studio database).
NOTION_LEADS_DB_ID=
# "Clientes em risco" — fed by churn-risk.ts (studio database, see below).
NOTION_CHURN_RISK_DB_ID=
# Competitor-intel pipeline (see docs/knowledge-base/competitor-intel.md) —
# founder-maintained sender list and the findings extracted from them.
NOTION_COMPETITOR_SOURCES_DB_ID=
NOTION_COMPETITOR_INTEL_DB_ID=

# Studio database (member numbers — the daily birthdays cron at 08:00, the
# intro-pack digests, and the weekly churn-risk / leads crons). The Postgres
# connection string for role `haven_va` exactly as Mafalda sends it (pooler,
# session mode, port 5432):
#   postgresql://haven_va.<project-ref>:<password>@aws-0-eu-central-1.pooler.supabase.com:5432/postgres
# That role can only read the va.v_pulse_* views and insert a pulse_cases
# flag — no kenko_* table, no PII beyond v_pulse_member_identity (see
# docs/knowledge-base/pulse-views.md). Optional: if missing, those crons log
# studio_db.disabled and no-op. Other bot features unaffected.
STUDIO_DATABASE_URL=
# Set to 1 only if the pooler's TLS certificate can't be verified from the NAS.
# STUDIO_DATABASE_SSL_NO_VERIFY=

# Google Calendar (run /auth in Madalena's DM after first boot).
# GOOGLE_CALENDAR_IDS is also scanned by crons/founder-meeting-check.ts to
# find the "Founders Meeting" / "Recurring Founders Meeting" event.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000
GOOGLE_CALENDAR_IDS=

# Gmail — competitor-intel ONE-OFF BACKFILL ONLY (see
# docs/knowledge-base/competitor-intel.md). Not used by the live weekly
# cron anymore — that reads OUTLOOK_COMPETITOR_INTEL_MAILBOX below instead,
# because gmail.modify is a Google "restricted" scope: unverified apps in
# Testing status get refresh tokens capped at 7 days, which breaks an
# unattended weekly cron (and full verification wasn't worth it for a
# single-tenant internal tool). Keep this only long enough to run
# scripts/backfill-competitor-intel.mjs once against the pre-migration
# Gmail backlog (yourhavenpilates@gmail.com), then it can be removed.
# Separate account from Google Calendar above — reuses the same
# GOOGLE_CLIENT_ID/SECRET app but needs its own OAuth consent (gmail.modify
# scope) and its own token storage. Run /auth_gmail in Madalena's DM.
# Production-only override: injects a refresh token without the token file.
GOOGLE_REFRESH_TOKEN_GMAIL_COMPETITOR=
# The Gmail label a founder already created to mark relevant newsletters —
# the (now backfill-only) tidy phase tags+archives matches from
# NOTION_COMPETITOR_SOURCES_DB_ID with this label; must already exist.
COMPETITOR_INTEL_LABEL=email marketing concorrência
# Created automatically by the bot on first use if missing. Messages carrying
# the label above but not this one are still awaiting extraction/Notion write.
COMPETITOR_INTEL_PROCESSED_LABEL=email marketing concorrência: processado
# Set to "true" to log what the competitor-intel backfill script (or the
# live Outlook cron below) WOULD do without mutating anything — sanity-check
# against the real inbox first, same as TIDY_MAILBOXES_DRY_RUN. Shared by
# both the Gmail backfill and the live Outlook pipeline.
COMPETITOR_INTEL_DRY_RUN=

# Outlook / Microsoft Graph (partnerships email sync — see docs/knowledge-base/outlook-partnerships-sync.md)
# Run `node scripts/outlook-auth.mjs` once to populate outlook-tokens.json under DATA_DIR.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=
MICROSOFT_REDIRECT_URI=http://localhost:3000
MICROSOFT_REFRESH_TOKEN_MADALENA=
# Comma-separated mailbox addresses to also scan beyond the authenticated
# account's own inbox ("me" is implicit) — the colleague's mailbox + shared inboxes.
# Requires Mail.Read.Shared consent + Exchange Full Access delegation on each address.
# Also reused as-is by src/crons/leads-email-scan.ts (Feature A leads) — same
# mailboxes, own checkpoint file, no new Microsoft scopes needed.
OUTLOOK_MAILBOXES=
# Optional extra keywords appended to the script's built-in PT/EN partnership keyword list.
OUTLOOK_PARTNERSHIP_KEYWORDS=
# Once a founder confirms a finding (create/update) via apply-outlook-findings.mjs,
# forward the original email here and archive it from whichever configured mailbox
# it came from (me, OUTLOOK_MAILBOXES — personal and shared alike). Leave unset to
# disable (no forward/archive, just the existing Notion write). Needs the same
# Mail.Send(.Shared)/Mail.ReadWrite(.Shared) scopes as tidy-mailboxes below.
OUTLOOK_PARTNERSHIP_FORWARD_TO=

# tidy-mailboxes cron (fully automatic — see docs/knowledge-base/tidy-mailboxes.md).
# Needs the same MICROSOFT_* app registration above PLUS Mail.ReadWrite(.Shared)
# and Mail.Send(.Shared) consented and re-authorized (re-run outlook-auth.mjs
# after adding those scopes — a token issued before won't have them).
# Comma-separated shared inboxes to tidy, e.g. geral@dominio.com,hello@dominio.com
OUTLOOK_TIDY_MAILBOXES=
# Where invoice-looking attachments get forwarded before the original is archived.
OUTLOOK_INVOICES_FORWARD_TO=
# Set to "true" to log what the cron WOULD do (would_archive/would_forward)
# without actually mutating anything — sanity-check on real mailboxes first.
TIDY_MAILBOXES_DRY_RUN=
# Optional extra exact sender addresses (comma-separated) that are always
# pure notifications (never an invoice, never actionable) — archived without
# ever calling Claude. Appended to a built-in default list of known couriers/
# Amazon shipping addresses; see src/crons/tidy-mailboxes.ts.
TIDY_MAILBOXES_AUTO_ARCHIVE_SENDERS=
# How many days a "needs action" tag stays trusted before the cron re-checks
# that message instead of skipping it forever. Default 7 if unset/invalid.
TIDY_MAILBOXES_RECHECK_AFTER_DAYS=

# competitor-intel cron, LIVE pipeline (see docs/knowledge-base/competitor-intel.md
# and the Gmail-backfill-only block above). Needs the same MICROSOFT_* app
# registration above PLUS Mail.ReadWrite(.Shared) — already consented if
# tidy-mailboxes below is set up. Requires Exchange Full Access delegation
# on this mailbox for whichever account holds the Microsoft refresh token,
# same as OUTLOOK_MAILBOXES/OUTLOOK_TIDY_MAILBOXES.
# The dedicated shared mailbox a founder resubscribes competitor/inspiration
# newsletters under — everything landing here IS the intake (no sender
# matching against the Fontes DB, unlike the old Gmail tidy phase).
OUTLOOK_COMPETITOR_INTEL_MAILBOX=
# Outlook category applied (alongside archiving) once a message is
# processed — purely a visual marker for browsing the Archive folder later,
# never read back by the cron. Default: "Competitor Intel: Processado".
OUTLOOK_COMPETITOR_INTEL_PROCESSED_CATEGORY=

# Deployment
DATA_DIR=/data
TZ=Europe/Lisbon
NODE_ENV=production
