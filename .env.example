# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_GROUP_ID=
TELEGRAM_MADALENA_ID=
TELEGRAM_MAFALDA_ID=
TELEGRAM_BEATRIZ_ID=

# Claude
ANTHROPIC_API_KEY=
MULTI_INTENT_MODEL=claude-haiku-4-5-20251001
# Optional override for src/lib/lead-classifier.ts (leads-email-scan cron).
LEAD_CLASSIFIER_MODEL=claude-haiku-4-5-20251001

# Notion
NOTION_API_KEY=
NOTION_BACKLOG_DB_ID=
NOTION_FOUNDER_FOCUS_DB_ID=
NOTION_PARTNER_DB_ID=
NOTION_INFLUENCER_DB_ID=
# Fornecedores (Suppliers) — created by hand in Notion first (or via the
# add-notion-db skill), then run scripts/setup-notion-dbs.mjs to add its
# schema. Missing ID disables supplier routing gracefully (vendor pitches
# stay dropped as noise, same as before 2026-09-22).
NOTION_SUPPLIER_DB_ID=
NOTION_REMINDERS_DB_ID=
NOTION_TO_DISCUSS_DB_ID=
NOTION_DECISIONS_DB_ID=
# Comms/Marketing content calendar. Only used by the pipeline-alerts cron to
# warn when something is due in <2 days but still Planned/Drafted (not
# Scheduled) — not exposed to chat.
NOTION_CONTENT_CALENDAR_DB_ID=
NOTION_LISTS_DB_ID=
NOTION_PROJECTS_DB_ID=
NOTION_EVENT_DB_ID=
# "Leads a contactar" — fed by leads-email-scan.ts (reuses OUTLOOK_MAILBOXES
# below, no new Microsoft scopes) and leads-intro-pack.ts (studio database).
NOTION_LEADS_DB_ID=
# "Clientes em risco" — fed by churn-risk.ts (studio database, see below).
NOTION_CHURN_RISK_DB_ID=
# Competitor-intel pipeline (see docs/knowledge-base/competitor-intel.md) —
# founder-maintained sender list and the findings extracted from them.
NOTION_COMPETITOR_SOURCES_DB_ID=
NOTION_COMPETITOR_INTEL_DB_ID=

# Studio database (member numbers — the daily birthdays cron at 08:00, the
# intro-pack digests, and the weekly churn-risk / leads crons). The Postgres
# connection string for role `haven_va` exactly as Mafalda sends it (pooler,
# session mode, port 5432):
#   postgresql://haven_va.<project-ref>:<password>@aws-0-eu-central-1.pooler.supabase.com:5432/postgres
# That role can only read the va.v_pulse_* views and insert a pulse_cases
# flag — no kenko_* table, no PII beyond v_pulse_member_identity (see
# docs/knowledge-base/pulse-views.md). Optional: if missing, those crons log
# studio_db.disabled and no-op. Other bot features unaffected.
STUDIO_DATABASE_URL=
# studio-db.ts pins Supabase's own root CA, so the pooler's TLS cert
# verifies correctly out of the box. Set this to 1 only as a last-resort
# override if Supabase ever rotates to a different root and the pin goes
# stale before the code is updated.
# STUDIO_DATABASE_SSL_NO_VERIFY=

# Google Calendar (run /auth in Madalena's DM after first boot).
# GOOGLE_CALENDAR_IDS is also scanned by crons/founder-meeting-check.ts to
# find the "Founders Meeting" / "Recurring Founders Meeting" event.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000
GOOGLE_CALENDAR_IDS=

# Set to "true" to log what the competitor-intel Outlook pipeline below
# WOULD do without mutating anything (no Notion writes, no isRead change) —
# sanity-check against the real mailbox first, same as MAIL_TRIAGE_DRY_RUN.
COMPETITOR_INTEL_DRY_RUN=

# Outlook / Microsoft Graph (partnerships email sync — see docs/knowledge-base/outlook-partnerships-sync.md)
# Run `node scripts/outlook-auth.mjs` once to populate outlook-tokens.json under DATA_DIR.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=
MICROSOFT_REDIRECT_URI=http://localhost:3000
MICROSOFT_REFRESH_TOKEN_MADALENA=
# Comma-separated mailbox addresses to also scan beyond the authenticated
# account's own inbox ("me" is implicit) — the colleague's mailbox + shared inboxes.
# Requires Mail.Read.Shared consent + Exchange Full Access delegation on each address.
# Also reused as-is by src/crons/leads-email-scan.ts (Feature A leads) — same
# mailboxes, own checkpoint file, no new Microsoft scopes needed.
OUTLOOK_MAILBOXES=
# Optional extra keywords appended to the script's built-in PT/EN partnership keyword list.
OUTLOOK_PARTNERSHIP_KEYWORDS=
# ── mail-triage cron (daily 07:00, src/crons/mail-triage.ts) ────────────
# One pass over "me" + OUTLOOK_MAILBOXES + OUTLOOK_TIDY_MAILBOXES: records
# partners/influencers/suppliers in Notion (every mailbox), forwards (below),
# and cleans only OUTLOOK_TIDY_MAILBOXES. Replaced tidy-mailboxes +
# sync-partnerships on 2026-09-30 — see docs/knowledge-base/mail-triage.md.
# Needs Mail.ReadWrite(.Shared) + Mail.Send(.Shared) consented (re-run
# outlook-auth.mjs after adding scopes — an older token won't have them).
#
# Shared inboxes the cron may ARCHIVE in, e.g. geral@dominio.com,hello@dominio.com
OUTLOOK_TIDY_MAILBOXES=
# Forward targets — each unset target simply disables that forward. Partner /
# supplier / application forwards only apply to mail received after the cron's
# first run (no backlog), and each email is forwarded at most once.
# Partner proposals (from any mailbox):
OUTLOOK_PARTNERSHIP_FORWARD_TO=
# Supplier emails found in a PERSONAL mailbox (not in OUTLOOK_TIDY_MAILBOXES), e.g. geral@:
OUTLOOK_SUPPLIERS_FORWARD_TO=
# Job / instructor applications (from any mailbox) — forwarded only, never recorded:
OUTLOOK_STAFF_FORWARD_TO=
# Supplier invoices found in a clean inbox:
OUTLOOK_INVOICES_FORWARD_TO=
# "true" = run everything incl. the AI calls but write NOTHING (no Notion, no
# forward, no archive, no category, no state file); logs mail_triage.would_*.
MAIL_TRIAGE_DRY_RUN=
# Optional extra exact sender addresses (comma-separated) that are pure
# notifications — archived in clean inboxes without any AI call. Appended to
# the built-in list in src/lib/mail-rules.ts.
TIDY_MAILBOXES_AUTO_ARCHIVE_SENDERS=
# Days a "needs action" verdict is trusted before it's re-checked. Default 7.
TIDY_MAILBOXES_RECHECK_AFTER_DAYS=
# Max AI-judged archives per clean inbox per run. Default 30.
TIDY_MAILBOXES_MAX_ARCHIVES_PER_RUN=

# competitor-intel cron (see docs/knowledge-base/competitor-intel.md). Needs
# the same MICROSOFT_* app registration above PLUS Mail.ReadWrite(.Shared) —
# already consented if tidy-mailboxes below is set up. Requires Exchange
# Full Access delegation on this mailbox for whichever account holds the
# Microsoft refresh token, same as OUTLOOK_MAILBOXES/OUTLOOK_TIDY_MAILBOXES.
# The dedicated shared mailbox a founder resubscribes competitor/inspiration
# newsletters under — everything landing here IS the intake (no sender
# matching against the Fontes DB). Unread = not yet processed; the cron
# marks each message read once it's written to Notion, nothing more (no
# category, no archiving — this mailbox has no other purpose to keep tidy).
OUTLOOK_COMPETITOR_INTEL_MAILBOX=

# Deployment
DATA_DIR=/data
TZ=Europe/Lisbon
NODE_ENV=production
